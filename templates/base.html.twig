<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
    <div class="pageWrapper w-100 d-flex justify-content-center">
        <div id="main-container">
            <nav class="d-flex justify-content-center">
                <div class="navWithWidth">
                    <a href="{{ path('app_home') }}" id="logo">
                    <img src={{asset('img/Logo.png')}} alt="Logo TaskLinker" />
                    </a>
                    <ul id="main-menu">
                        <li class="">
                            <a href="{{ path('app_home') }}">
                                Nos Produits
                            </a>
                        </li>
                        {% if app.user %}
                        <li class="">
                            <a href="{{ path('app_cart') }}">
                                Mon panier {% if cartCount > 0 %} ({{ cartCount }}) {% endif %}
                            </a>
                        </li>
                        <li class="">
                            <a href="{{ path('app_account') }}">
                                Mon compte
                            </a>
                        </li>
                        <li class="">
                            <a href="{{ path('app_logout') }}">
                                Déconnexion
                            </a>
                        </li>
                        {% else %}
                        <li class="">
                            <a href="{{ path('app_login') }}">
                                Connexion
                            </a>
                        </li>
                        {% endif %}                        
                    </ul>           
                </div>
            </nav>
            <main class="d-flex">
                <header>
                    <div id="title-page">
                        {% block header %}{% endblock %}
                    </div>
                </header>
                <div id="content">
                    {% block body %}{% endblock %}
                </div>
            </main>
            <footer>
                <div class="container-fluid d-flex align-items-center justify-content-end pe-5">
                    © GreenGoodies - 2026
                </div>
            </footer>
        </div>
    </div>
        

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
