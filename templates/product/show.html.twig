{% extends 'base.html.twig' %}

{% block title %}Product Page{% endblock %}

{% block body %}
<section class="productSection h-100">
    <div class="container-fluid p-0">
        <div class="row g-0">
            <div class="col-12 col-md-6">
                <img
                    src="{{ asset('img/products/compressed/' ~ product.imageFileName) }}"
                    alt="{{ product.name }}"
                    class="productPageImage"
                >
            </div>

            <div class="col-12 col-md-6 colProductDetails d-flex align-items-end justify-content-center">
                <div class="productDetails h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="productTitle">{{ product.name }}</div>
                        <div class="productPrice">{{ product.price|number_format(2, ',', ' ') }}€</div>
                        <div class="productDescription mt-4">
                            <h4>Description</h4>
                            {{ product.description }}
                        </div>
                    </div>
                    <div class="addToCart mt-4">
                        {# if user is not connected #}
                        {% if not app.user %}
                            <a href="{{ path('app_login') }}" class="btn btn-secondary btn-lg w-100">
                                Se connecter pour ajouter au panier
                            </a>

                        {# is user is connected #}
                        {% else %}
                            <form method="post" action="{{ path('app_product_add', { id: product.id }) }}" class="d-flex flex-column gap-3">
                                <div class=" productQuantity d-flex align-items-center">
                                    <label for="quantity">Quantité</label>
                                        <input
                                            type="number"
                                            id="quantity"
                                            name="quantity"
                                            min="0"
                                            value="{{ currentQty }}"
                                            class="form-control"
                                        >
                                </div>
                                <button type="submit" class="btn btn-secondary btn-lg w-100">
                                    {{ currentQty > 0 ? 'Mettre à jour' : 'Ajouter au panier' }}
                                </button>
                            </form>
                        {% endif %}

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
